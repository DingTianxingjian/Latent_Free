+def piper_dataset_transform(trajectory: Dict[str, Any]) -> Dict[str, Any]:
+    # acdc_la 2026-11-06: actions are already [6 joint targets, gripper in 0..1] (convert_piper_rlds.py); state is the
+    # raw 14-D Piper vector, eef pose at 7:13 (unused: post-training runs with load_proprio=False)
+    trajectory["observation"]["EEF_state"] = trajectory["observation"]["state"][:, 7:13]
+    trajectory["observation"]["gripper_state"] = trajectory["observation"]["state"][:, 6:7]
+    return trajectory

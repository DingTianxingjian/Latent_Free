diff --git a/prismatic/vla/datasets/rlds/oxe/transforms.py b/prismatic/vla/datasets/rlds/oxe/transforms.py
index 47d90b5..f036d1d 100644
--- a/prismatic/vla/datasets/rlds/oxe/transforms.py
+++ b/prismatic/vla/datasets/rlds/oxe/transforms.py
@@ -848,6 +848,14 @@ def libero_dataset_transform(trajectory: Dict[str, Any]) -> Dict[str, Any]:
     return trajectory
 
 
+def piper_dataset_transform(trajectory: Dict[str, Any]) -> Dict[str, Any]:
+    # acdc_la 2026-11-06: actions are already [6 joint targets, gripper in 0..1] (convert_piper_rlds.py); state is the
+    # raw 14-D Piper vector, eef pose at 7:13 (unused: post-training runs with load_proprio=False)
+    trajectory["observation"]["EEF_state"] = trajectory["observation"]["state"][:, 7:13]
+    trajectory["observation"]["gripper_state"] = trajectory["observation"]["state"][:, 6:7]
+    return trajectory
+
+
 def human_dataset_transform(sample: Dict[str, Any]) -> Dict[str, Any]:
     """
     Transforms human data into the expected format by adding dummy actions.
@@ -956,6 +964,8 @@ OXE_STANDARDIZATION_TRANSFORMS = {
     "libero_spatial_no_noops": libero_dataset_transform,
     "libero_object_no_noops": libero_dataset_transform,
     "libero_goal_no_noops": libero_dataset_transform,
+    "piper_pick_can": piper_dataset_transform,
+    "press_button": piper_dataset_transform,
     "libero_10_no_noops": libero_dataset_transform,
     "libero_10_no_noops_mini": libero_dataset_transform,
     "libero_goal_no_noops_mini": libero_dataset_transform,
